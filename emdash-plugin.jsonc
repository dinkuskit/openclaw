{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-openclaw",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "OpenClaw",
  "description": "Connect custom OpenClaw agents and gateways to the EmDash CMS admin with Block Kit approval cards and MCP tools.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/openclaw/security"
  },
  "repo": "https://github.com/dinkuskit/openclaw",
  "capabilities": [
    "network:request",
    "schema:read",
    "content:read",
    "admin.editor-draft:read",
    "admin.editor-draft:patch"
  ],
  "allowedHosts": [
    "dinkuskit.com"
  ],
  "storage": {},
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "OpenClaw gateway connection",
        "description": "Encrypted OpenClaw gateway endpoint, agent ID, and bearer token. Managed on the OpenClaw page; do not edit raw JSON here."
      }
    },
    "pages": [
      {
        "path": "/openclaw",
        "label": "OpenClaw",
        "icon": "bot",
        "group": "Dinkus OpenClaw"
      }
    ]
  }
}
