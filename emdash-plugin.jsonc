{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-openclaw",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "OpenClaw",
  "description": "Connect custom OpenClaw agents and gateways to any EmDash CMS site with configurable editor panels and approval cards.",
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://github.com/dinkuskit"
  },
  "security": {
    "url": "https://github.com/dinkuskit/openclaw/security"
  },
  "repo": "https://github.com/dinkuskit/openclaw",
  "capabilities": [
    "network:request:unrestricted",
    "schema:read",
    "content:read"
  ],
  "storage": {},
  "admin": {
    "settingsSchema": {
      "connection": {
        "type": "secret",
        "label": "OpenClaw gateway connection",
        "description": "Encrypted OpenClaw gateway endpoint, agent ID, bearer token, and enabled content collections. Managed on the OpenClaw page."
      }
    },
    "pages": [
      {
        "path": "/openclaw",
        "label": "OpenClaw",
        "icon": "bot",
        "group": "OpenClaw"
      }
    ],
    "editorPanels": [
      {
        "id": "openclaw-assistant",
        "title": "OpenClaw Assistant",
        "route": "editor/assistant"
      }
    ]
  }
}
